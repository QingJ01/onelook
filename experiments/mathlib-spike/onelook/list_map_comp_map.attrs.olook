                        {
                          "id": "7aeec22e-21e4-4218-8352-53ca44bb7413",
                          "text": "签名: {α : Sort u} → {β : Sort v} → {δ : Sort w} → (β → δ) → (α → β) → α → δ",
                          "children": [],
                          "isExpanded": true,
                          "parentId": "05c9f524-1623-4935-958b-c06f55bae90f",
                          "data": {
                            "note": "**签名**\n\n{α : Sort u} → {β : Sort v} → {δ : Sort w} → (β → δ) → (α → β) → α → δ",
                            "tags": [
                              "attribute",
                              "签名"
                            ]
                          },
                          "style": {
