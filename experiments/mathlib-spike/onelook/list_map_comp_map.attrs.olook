                        {
                          "id": "88ba51c0-7452-4837-b17c-992907af7435",
                          "text": "签名: {coll : Type u} → {idx : Type v} → {elem : outParam (Type w)} → {valid : outPar…",
                          "children": [],
                          "isExpanded": true,
                          "parentId": "741f00d3-9b83-43c6-9b61-e7fcf6c9b17f",
                          "data": {
                            "note": "**签名**\n\n{coll : Type u} → {idx : Type v} → {elem : outParam (Type w)} → {valid : outParam (coll → idx → Prop)} → [self : GetElem? coll idx elem valid] → coll → idx → Option elem",
