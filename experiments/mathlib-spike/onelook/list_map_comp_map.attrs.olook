                      "id": "20bd898f-b034-4cfb-a725-b2db7d0d0b23",
                      "text": "签名: {α : Type u_1} → {β : Type u_2} → (α → β) → List α → List β",
                      "children": [],
                      "isExpanded": true,
                      "parentId": "a469ffe7-1be8-4973-90b8-edb82fafd4d6",
                      "data": {
                        "note": "**签名**\n\n{α : Type u_1} → {β : Type u_2} → (α → β) → List α → List β",
                        "tags": [
                          "attribute",
                          "签名"
                        ]
                      },
