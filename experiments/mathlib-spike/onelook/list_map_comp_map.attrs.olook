                        {
                          "id": "ef3f6b14-0546-4792-bff4-a7fc4157669f",
                          "text": "签名: {α : Sort u_1} → α → α → Prop",
                          "children": [],
                          "isExpanded": true,
                          "parentId": "eac08b29-0dc2-4002-be50-cc5fc37b695b",
                          "data": {
                            "note": "**签名**\n\n{α : Sort u_1} → α → α → Prop",
                            "tags": [
                              "attribute",
                              "签名"
                            ]
                          },
                          "style": {
