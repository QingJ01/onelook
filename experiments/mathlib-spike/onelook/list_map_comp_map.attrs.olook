                        {
                          "id": "3efa3a89-4dd1-4fe3-b568-b4a2f396a2d6",
                          "text": "模块: Init.GetElem",
                          "children": [],
                          "isExpanded": true,
                          "parentId": "5cbfe340-0c11-4058-a2c8-324b7c97f211",
                          "data": {
                            "note": "**模块**\n\nInit.GetElem",
                            "tags": [
                              "attribute",
