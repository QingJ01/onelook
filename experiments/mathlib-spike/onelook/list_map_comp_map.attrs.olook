                        {
                          "id": "5d939f79-97de-4e2e-a7c2-42b08db7f170",
                          "text": "签名: {α : Sort u} → (r : α → α → Prop) → α → Quot r",
                          "children": [],
                          "isExpanded": true,
                          "parentId": "e0cb4653-5b31-4b60-a05c-d095b385238c",
                          "data": {
                            "note": "**签名**\n\n{α : Sort u} → (r : α → α → Prop) → α → Quot r",
                            "tags": [
                              "attribute",
                              "签名"
                            ]
                          },
                          "style": {
