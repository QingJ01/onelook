                        {
                          "id": "ec42aa55-410b-4310-9ffd-18cce89a686c",
                          "text": "签名: (coll : Type u) → (idx : Type v) → outParam (Type w) → outParam (coll → idx → P…",
                          "children": [],
                          "isExpanded": true,
                          "parentId": "5cbfe340-0c11-4058-a2c8-324b7c97f211",
                          "data": {
                            "note": "**签名**\n\n(coll : Type u) → (idx : Type v) → outParam (Type w) → outParam (coll → idx → Prop) → Type (max (max u v) w)",
                            "tags": [
                              "attribute",
                              "签名"
                            ]
                          },
                          "style": {
                            "background": "#f9fafb",
                            "color": "#6b7280",
