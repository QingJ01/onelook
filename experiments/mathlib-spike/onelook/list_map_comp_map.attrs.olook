                          "text": "签名: {α : Sort u} → α → α",
                          "children": [],
                          "isExpanded": true,
                          "parentId": "2979eb5c-604c-4a17-9920-cedb2faa04b3",
                          "data": {
                            "note": "**签名**\n\n{α : Sort u} → α → α",
