                        {
                          "id": "1022e48f-7d1b-4751-a42e-eefbb09e1029",
                          "text": "签名: {α : Sort u} → (α → α → Prop) → Sort u",
                          "children": [],
                          "isExpanded": true,
                          "parentId": "4752fccf-caaf-4ad5-b309-634daee74224",
                          "data": {
                            "note": "**签名**\n\n{α : Sort u} → (α → α → Prop) → Sort u",
                            "tags": [
                              "attribute",
                              "签名"
                            ]
                          },
                          "style": {
