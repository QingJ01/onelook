                    {
                      "id": "435fa48d-a68b-4a6a-8347-9641f58c8636",
                      "text": "签名: ∀ {α : Type u} {β : Type v} {γ : Type w} (h : β → γ) (g : α → β) (l : List α), …",
                      "children": [],
                      "isExpanded": true,
                      "parentId": "1bf1e063-ad31-4c83-886b-d83795af4fbb",
                      "data": {
                        "note": "**签名**\n\n∀ {α : Type u} {β : Type v} {γ : Type w} (h : β → γ) (g : α → β) (l : List α), List.map (h ∘ g) l = List.map h (List.map g l)",
                        "tags": [
                          "attribute",
                          "签名"
                        ]
                      },
                      "style": {
                        "background": "#f9fafb",
                        "color": "#6b7280",
                        "fontSize": 11,
