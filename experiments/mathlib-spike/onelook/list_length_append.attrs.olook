                        {
                          "id": "214ae20f-2a20-4973-92d9-7ba3507a310c",
                          "text": "签名: ∀ {α : Sort u} {a b c : α}, a = b → b = c → a = c",
                          "children": [],
                          "isExpanded": true,
                          "parentId": "92dcd5c7-0482-4583-b0b0-41d91ed60d2c",
                          "data": {
                            "note": "**签名**\n\n∀ {α : Sort u} {a b c : α}, a = b → b = c → a = c",
                            "tags": [
                              "attribute",
                              "签名"
                            ]
                          },
                          "style": {
                            "background": "#f9fafb",
                            "color": "#6b7280",
