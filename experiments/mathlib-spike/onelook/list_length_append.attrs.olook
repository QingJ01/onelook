                        {
                          "id": "4cf00fe2-f855-4b1b-a5b7-112730b402ed",
                          "text": "签名: Type u → ℕ → Type u",
                          "children": [],
                          "isExpanded": true,
                          "parentId": "08905b11-c276-483c-9d84-c8da230a4eec",
                          "data": {
                            "note": "**签名**\n\nType u → ℕ → Type u",
                            "tags": [
                              "attribute",
                              "签名"
                            ]
                          },
                          "style": {
