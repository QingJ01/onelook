                        {
                          "id": "d20e8b6a-5b73-42eb-b8ad-6b394dcd5238",
                          "text": "模块: Init.Prelude",
                          "children": [],
                          "isExpanded": true,
                          "parentId": "3ce370ac-bc10-412d-a280-e7c295bb9de6",
