                    "borderColor": "#86efac"
                  }
                },
                {
                  "id": "ce61f583-c524-433e-a16b-fe21aa404c2d",
                  "text": "[陈述] instAddNat",
                  "children": [
                    {
                      "id": "f6f8260b-925e-43d5-b7e8-88f1221f2659",
                      "text": "属性",
                      "children": [
                        {
                          "id": "0654f2a3-9cf9-4802-bb0c-94fd11af9880",
                          "text": "层: 陈述",
                          "children": [],
                          "isExpanded": true,
                          "parentId": "f6f8260b-925e-43d5-b7e8-88f1221f2659",
                          "data": {
                            "note": "**层**\n\n陈述",
                            "tags": [
                              "attribute",
                              "层"
                            ]
                          },
                          "style": {
                            "background": "#f9fafb",
                            "color": "#6b7280",
                            "fontSize": 11,
                            "borderColor": "#e5e7eb"
                          }
                        },
                        {
                          "id": "4c54ddd5-c1fe-4587-af2c-11459a2e041b",
                          "text": "类型: definition",
                          "children": [],
                          "isExpanded": true,
