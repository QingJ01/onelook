                        {
                          "id": "c93d5590-3445-4160-b901-d24f7b73cdff",
                          "text": "模块: Init.Prelude",
                          "children": [],
                          "isExpanded": true,
                          "parentId": "ba9e15cb-50a3-43b3-8bcd-833d32d3f612",
                          "data": {
                            "note": "**模块**\n\nInit.Prelude",
