                        },
                        {
                          "id": "bcdd6809-9701-494d-b41f-f51ff93b3c64",
                          "text": "模块: Init.Core",
                          "children": [],
                          "isExpanded": true,
                          "parentId": "1589beec-4a79-4d1e-80d2-1bf5b2e3a947",
                          "data": {
                            "note": "**模块**\n\nInit.Core",
