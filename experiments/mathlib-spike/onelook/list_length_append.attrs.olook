                        {
                          "id": "bcc48fd7-aa3d-4dab-a146-7a4cb4498254",
                          "text": "签名: Type",
                          "children": [],
                          "isExpanded": true,
                          "parentId": "9283af1d-01a9-4d4a-adde-83ff584391c6",
                          "data": {
                            "note": "**签名**\n\nType",
