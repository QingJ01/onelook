                        },
                        {
                          "id": "001e8877-d192-40cd-8feb-3205ee1341ed",
                          "text": "模块: Init.Prelude",
                          "children": [],
                          "isExpanded": true,
                          "parentId": "1816bbd1-393f-414b-bdcc-57094ad910e7",
                          "data": {
                            "note": "**模块**\n\nInit.Prelude",
