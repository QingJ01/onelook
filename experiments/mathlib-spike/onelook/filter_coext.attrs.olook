            {
              "id": "30b8ed13-da97-40ec-b4be-6e429c6d8116",
              "text": "等式与同余",
              "children": [
                {
                  "id": "3be4834c-ee7c-4a70-bb63-6e76d5d289fd",
                  "text": "[陈述] Eq",
                  "children": [
                    {
                      "id": "1816bbd1-393f-414b-bdcc-57094ad910e7",
                      "text": "属性",
                      "children": [
                        {
                          "id": "81c369d1-e3b8-4539-842a-65ec7bef812b",
