                          "text": "签名: Type u → Type u",
                          "children": [],
                          "isExpanded": true,
                          "parentId": "745d30ad-13e8-48bc-83c0-498337d765a4",
                          "data": {
                            "note": "**签名**\n\nType u → Type u",
