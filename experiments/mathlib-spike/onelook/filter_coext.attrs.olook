                        },
                        {
                          "id": "16c651a4-d005-46fd-a994-7cbe744b77e8",
                          "text": "类型: inductive",
                          "children": [],
                          "isExpanded": true,
                          "parentId": "1816bbd1-393f-414b-bdcc-57094ad910e7",
