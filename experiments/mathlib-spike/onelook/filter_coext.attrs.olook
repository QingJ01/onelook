                        {
                          "id": "13dca77a-b1ba-4d20-9b83-e6b06881078f",
                          "text": "签名: {α : Sort u} → (α → Prop) → Prop",
                          "children": [],
                          "isExpanded": true,
                          "parentId": "f0f4b0ff-7333-46c8-b03b-af631cdec066",
                          "data": {
                            "note": "**签名**\n\n{α : Sort u} → (α → Prop) → Prop",
                            "tags": [
                              "attribute",
                              "签名"
                            ]
                          },
                          "style": {
                            "background": "#f9fafb",
                            "color": "#6b7280",
