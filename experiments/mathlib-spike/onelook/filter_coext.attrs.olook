                        {
                          "id": "df9ad5cc-5192-43d2-b146-82f0986f4866",
                          "text": "模块: Mathlib.Order.BooleanAlgebra.Defs",
                          "children": [],
                          "isExpanded": true,
                          "parentId": "1ceda38a-35da-460d-822a-9ddf977ab542",
                          "data": {
                            "note": "**模块**\n\nMathlib.Order.BooleanAlgebra.Defs",
                            "tags": [
