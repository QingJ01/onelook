                        },
                        {
                          "id": "32c747d8-1014-47ce-b842-fa47203b9098",
                          "text": "签名: {α : Sort u_1} → α → α → Prop",
                          "children": [],
                          "isExpanded": true,
                          "parentId": "1816bbd1-393f-414b-bdcc-57094ad910e7",
                          "data": {
                            "note": "**签名**\n\n{α : Sort u_1} → α → α → Prop",
                            "tags": [
                              "attribute",
                              "签名"
                            ]
                          },
                          "style": {
                            "background": "#f9fafb",
                            "color": "#6b7280",
