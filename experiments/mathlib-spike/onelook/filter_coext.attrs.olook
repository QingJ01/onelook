                        {
                          "id": "9137703d-c77a-4ea5-a42c-e342f8fcd4ea",
                          "text": "签名: Type u → Type u",
                          "children": [],
                          "isExpanded": true,
                          "parentId": "1ceda38a-35da-460d-822a-9ddf977ab542",
                          "data": {
                            "note": "**签名**\n\nType u → Type u",
                            "tags": [
