                        },
                        {
                          "id": "b003e267-d53d-448d-8956-f0097da6ff5e",
                          "text": "模块: Init.Prelude",
                          "children": [],
                          "isExpanded": true,
                          "parentId": "7241b040-675a-45a5-bebe-10b319fb4e87",
                          "data": {
                            "note": "**模块**\n\nInit.Prelude",
