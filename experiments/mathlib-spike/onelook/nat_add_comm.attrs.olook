                        {
                          "id": "7eb32ae2-1ea8-49a9-ac43-bfdf62b139bd",
                          "text": "模块: Init.Prelude",
                          "children": [],
                          "isExpanded": true,
                          "parentId": "44c4cfd5-72dd-41f4-8e52-debc01ac2c38",
