                        {
                          "id": "cfea94f7-dce6-4629-93ad-58f5022cee61",
                          "text": "模块: Init.Prelude",
                          "children": [],
                          "isExpanded": true,
                          "parentId": "2aa1e6c1-f43f-4667-a59d-709259160735",
