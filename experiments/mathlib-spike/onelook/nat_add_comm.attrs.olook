                          }
                        },
                        {
                          "id": "a82eab9b-f6e0-4eac-af73-c7e9ecb4c7e5",
                          "text": "类型: inductive",
                          "children": [],
                          "isExpanded": true,
                          "parentId": "7241b040-675a-45a5-bebe-10b319fb4e87",
                          "data": {
                            "note": "**类型**\n\ninductive",
                            "tags": [
                              "attribute",
