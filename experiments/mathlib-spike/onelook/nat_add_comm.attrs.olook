            },
            {
              "id": "182526cb-2259-4f44-9b14-0e0ce4cbf963",
              "text": "等式与同余",
              "children": [
                {
                  "id": "e4945be4-920c-49df-80ee-3fa0f794c0bb",
                  "text": "[陈述] Eq",
                  "children": [
                    {
                      "id": "7241b040-675a-45a5-bebe-10b319fb4e87",
                      "text": "属性",
                      "children": [
                        {
                          "id": "ff46ab82-dd2a-4564-bbec-ddf62563bc28",
                          "text": "层: 陈述",
                          "children": [],
                          "isExpanded": true,
                          "parentId": "7241b040-675a-45a5-bebe-10b319fb4e87",
                          "data": {
                            "note": "**层**\n\n陈述",
                            "tags": [
                              "attribute",
