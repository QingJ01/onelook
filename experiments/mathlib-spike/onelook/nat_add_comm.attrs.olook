                        {
                          "id": "c7263c4a-852f-4fb4-8008-6965730c25e1",
                          "text": "签名: ∀ {α : Sort u} {a b : α}, a = b → b = a",
                          "children": [],
                          "isExpanded": true,
                          "parentId": "30355eb8-fbdc-4fe9-a863-9a8e6da7024b",
                          "data": {
                            "note": "**签名**\n\n∀ {α : Sort u} {a b : α}, a = b → b = a",
                            "tags": [
                              "attribute",
                              "签名"
                            ]
                          },
                          "style": {
