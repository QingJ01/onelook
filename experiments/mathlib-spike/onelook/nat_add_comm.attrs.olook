                        {
                          "id": "abfb7fb0-1c63-47f2-b7b5-82ae7365d7fa",
                          "text": "签名: {α β : Sort u} → α = β → β → α",
                          "children": [],
                          "isExpanded": true,
                          "parentId": "ad9b948e-cc5d-47e6-899b-b2c56d9f6999",
                          "data": {
                            "note": "**签名**\n\n{α β : Sort u} → α = β → β → α",
                            "tags": [
