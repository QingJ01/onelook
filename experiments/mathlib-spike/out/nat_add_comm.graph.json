   "id": "Nat.brecOn.go",
   "docstring": ""},
  {"signature":
   "∀ (motive : ℕ → ℕ → Prop) (x x_1 : ℕ), (∀ (n : ℕ), motive n 0) → (∀ (n m : ℕ), motive n m.succ) → motive x x_1",
   "module": "Init.Data.Nat.Basic",
