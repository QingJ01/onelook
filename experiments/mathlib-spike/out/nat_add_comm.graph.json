  {"signature":
   "∀ (x : ℕ) (f : Nat.below (motive := fun x => ∀ (x_1 : ℕ), x_1 + x = x + x_1) x) (x_1 : ℕ), x_1 + x = x + x_1",
   "module": "Init.Data.Nat.Basic",
